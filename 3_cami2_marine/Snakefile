import extern
import polars as pl

# Benchmark 3: CAMI2 marine datasets, with the ground-truth taxonomy remapped to
# GTDB r207. Unlike benchmarks 1/5/6 the reads are not simulated here (they are
# staged from the CAMI download, see stage_reads.sh); the ground truth comes from
# the CAMI genome-to-id map + per-genome read counts, converted to a condensed
# profile by generate_truth_condensed_format below. Everything downstream of the
# condensed profile (biobox, OPAL) and the per-tool profiling reuse ../rules.

sys.path.append(os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(workflow.snakefile)), '..')))
from tool_reference_data import *

num_threads = config['benchmarking_threads']

# Comparison set + coverm (strobealign) for this run.
tools = ['singlem', 'sylph', 'singlem-regime3', 'metaphlan', 'coverm']

output_prefix = 'output_'
# output_dirs_dict covers every tool the shared rules might reference at parse
# time, while `tools` above drives what `rule all` / opal actually build.
_all_possible_tools = ['singlem', 'metaphlan', 'kraken', 'sourmash', 'metabuli',
                       'sylph', 'metaphlan42', 'coverm', 'singlem-regime3']
output_dirs = list([output_prefix+tool for tool in tools])
output_dirs_dict = {tool: output_prefix+tool for tool in _all_possible_tools}

benchmark_dir = 'benchmarks'

fastq_dir = 'split_reads'
truth_dir = 'truths'

# marine0's upstream CAMI reads are a 0-byte placeholder, so start at marine1.
datasets = list(['marine'+str(i) for i in range(1, 10)])

# Debug
# tools = ['singlem']
# datasets = [datasets[0]]
print("Profiling {} over {} communities".format(tools, len(datasets)))

gtdbtk_output_dir = 'gtdbtk_r207'
genome_lengths_directory = 'genome_lengths'
read_counts_directory = 'read_mapping_counts'

##################################################################### reference databases
# Local (per-run) copies of the tool databases, staged by ../rules/staging.smk.

singlem_metapackage_local = join(output_dirs_dict['singlem'], 'data', os.path.basename(singlem_metapackage))
metaphlan_db_local1 = output_dirs_dict['metaphlan'] + '/metaphlan/data/metaphlan_bowtiedb'
sylph_db_local = output_dirs_dict['sylph'] + '/sylph/data/gtdb_database.syldb'
# coverm maps against coverm_reference_fna (from tool_reference_data.py); its
# strobealign index is built by ../rules/staging.smk.

# singlem-regime3 (weebill --two-stage + singlem pipe + condense --joint).
singlem_regime3_git_base_directory = os.path.join(workflow.basedir, '../singlem_sylph_condense_regime')
regime3_weebill_scripts = os.path.join(singlem_regime3_git_base_directory, 'extras/singlem_weebill_benchmark/scripts')
singlem_regime3_metapackage_local = join(output_dirs_dict['singlem-regime3'], 'data', os.path.basename(singlem_metapackage))

# Databases this benchmark stages locally (opt-in for ../rules/staging.smk).
staged_tools = tools

#####################################################################

# Constrain wildcards so the generic {tool}/{tool} biobox+opal rules cannot
# greedily match across path separators (a tool name contains a hyphen and
# shares the `singlem` prefix: singlem-regime3).
wildcard_constraints:
    tool="[A-Za-z0-9._-]+",
    sample="[A-Za-z0-9._]+",

# PBS/aqua jobs start in $HOME, not the workdir; cd in so workdir-relative paths
# (bin/, gtdbtk_r207, genome_to_id.tsv, ../*_taxonomy_r207.tsv) and the pixi
# manifest resolve on compute nodes.
shell.prefix("cd {} && ".format(workflow.basedir))

# Trivial table conversions run on the orchestrator host, not as 48h queue jobs.
localrules:
    generate_truth_condensed_format,
    truth_condensed_to_biobox,
    tool_condensed_to_biobox,
    sylph_report_to_condensed,
    coverm_to_condensed,

rule all:
    input:
        expand(output_prefix+"{tool}/opal/{sample}.opal_report", sample=datasets, tool=tools)

# Benchmark-3-specific: build the ground-truth condensed profile from the CAMI
# genome-to-id map, per-genome lengths and read-mapping counts (there is no ART
# read simulation here, so ../rules/data_generation.smk does not apply).
rule generate_truth_condensed_format:
    output:
        condensed = truth_dir + "/{sample}.condensed",
    log:
        truth_dir + "/logs/generate_truth_condensed_format-{sample}.log"
    shell:
        "{workflow.basedir}/../bin/cami_coverage_to_condensed.py --gtdbtk-output-directory {gtdbtk_output_dir} " \
        "--genome-to-id genome_to_id.tsv " \
        "--genome-lengths-directory {genome_lengths_directory} " \
        "--read-mapping-counts {read_counts_directory}/{wildcards.sample}.tsv " \
        ">{output.condensed} 2> {log}"

# Shared rules (../rules): DB staging, common conversions/OPAL, and one file per
# profiler this benchmark runs.
include: "../rules/staging.smk"
include: "../rules/common.smk"
include: "../rules/singlem_run.smk"
include: "../rules/metaphlan_run.smk"
include: "../rules/sylph_run.smk"
include: "../rules/coverm_run.smk"
include: "../rules/singlem_regime3_run.smk"
