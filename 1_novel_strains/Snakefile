
import extern
import os

# Benchmark 1 ('known species' / novel strains): communities simulated from
# non-representative GTDB r207 genomes whose *species* is in the tool databases.
# This is also the runtime/RAM benchmark (see run_benchmark.sh, which runs
# single-threaded), so the per-tool thread counts here are deliberate.
#
# Read generation and the low-abundance-removal variant are bench1-specific and
# defined below; everything else (DB staging, condensed->biobox->OPAL, per-tool
# profiling) is shared from ../rules.

sys.path.append(os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(workflow.snakefile)), '..')))
from tool_reference_data import *

num_threads = config['benchmarking_threads']
kraken_num_threads = 999 # never let kraken be parallelised, because otherwise it will exhaust the RAM.
if 'kraken_threads' in config:
    kraken_num_threads = config['kraken_threads']
# bench1 caps metabuli parallelism the same way kraken is capped (both are
# RAM-heavy); the shared rules/metabuli_run.smk reads this override.
metabuli_threads = kraken_num_threads
truth_dir = os.path.join(workflow.basedir, 'truths')
genome_fasta_paths = os.path.join(workflow.basedir, 'shadow_genome_paths.csv')
coverage_definitions_folder = 'coverage_definitions'

sys.path.append(os.path.abspath(os.path.dirname(os.path.abspath(workflow.snakefile))))
from bench1_setup import *

generated_fastq_dir = os.path.join(workflow.basedir, 'generated_reads')
fastq_dir = os.path.join(workflow.basedir, 'local_reads')

datasets = [f'marine{i}' for i in range(10)]

# The sylph-condense-regime3 branch of SingleM (submodule) + its weebill scripts,
# consumed by ../rules/singlem_regime3_run.smk.
singlem_regime3_git_base_directory = os.path.join(workflow.basedir, '../singlem_sylph_condense_regime')
regime3_weebill_scripts = os.path.join(singlem_regime3_git_base_directory, 'extras/singlem_sylph_weebill_benchmark/scripts')
singlem_regime3_metapackage_local = join(output_dirs_dict['singlem-regime3'], 'data', os.path.basename(singlem_metapackage))

# Databases this benchmark stages locally (opt-in for ../rules/staging.smk). Note
# `tools` is narrowed to r207_tools in bench1_setup, so name the staged set
# explicitly rather than deriving it from `tools`.
staged_tools = {'singlem', 'metaphlan', 'kraken', 'sourmash', 'metabuli', 'sylph', 'singlem-regime3'}

# Constrain wildcards so the generic {tool}/{tool} biobox+opal rules cannot
# greedily match across path separators now that a tool name contains a hyphen
# and shares the `singlem` prefix (singlem-regime3).
wildcard_constraints:
    tool="[A-Za-z0-9._-]+",
    method="[A-Za-z0-9._]+",
    sample="[A-Za-z0-9._]+",

# Prepend `cd <workdir>` to every rule's shell. Cluster jobs submitted via the
# aqua profile (snakemake_mqsub -> PBS) start in $HOME, not the snakemake working
# directory, which breaks the many rules that use workdir-relative paths
# (output_<tool>/..., ../bac120_metadata_r207.tsv) and pixi manifest discovery
# (../pixi.toml). Harmless no-op for local execution where CWD is already here.
shell.prefix("cd {} && ".format(workflow.basedir))

#####################################################################


rule all:
    input:
        expand(output_prefix+"{tool}/opal/{sample}.opal_report", sample=datasets, tool=tools),
        expand(output_prefix+"{tool}/opal_low_abund/{sample}.opal_report", sample=datasets, tool=tools),

# These rules are trivial (fast Python table conversions). Run them on the
# snakemake host rather than submitting each as its own cluster job, otherwise
# they sit in the queue holding a full default walltime allocation (48h) for
# work that takes seconds.
localrules:
    truth_condensed_to_biobox,
    tool_condensed_to_biobox,
    tool_condensed_to_biobox_low_abund,
    remove_low_abundance_from_condensed,
    sylph_report_to_condensed,

rule generate_all_communities:
    input:
        [f'{truth_dir}/marine{i}.finished' for i in range(10)],
        [f'{fastq_dir}/marine{i}.finished' for i in range(10)],
        [f'{truth_dir}/marine{i}.condensed.biobox' for i in range(10)],

# Read generation is bench1-specific: the coverage file for sample marineN is
# coverage_definitions/coverage<N>.tsv (rather than the <sample>.tsv mapping the
# shared ../rules/data_generation.smk expects), and generate_community.py
# hardcodes some bench1-relative paths.
rule generate_community_and_reads:
    output:
        r1=fastq_dir + "/{sample}.1.fq.gz",
        r2=fastq_dir + "/{sample}.2.fq.gz",
        condensed = truth_dir + "/{sample}.condensed",
        genomewise = truth_dir + "/{sample}.genomewise.csv",
        done = touch(truth_dir + "/{sample}.finished"),
        done2 = touch(fastq_dir + "/{sample}.finished"),
    params:
        coverage_number = lambda wildcards: wildcards.sample.replace('marine', ''),
    threads: num_threads
    log:
        truth_dir + "/{sample}.readgen.log",
    shell:
        # cd into the workflow dir so relative paths (../bac120_metadata_r207.tsv,
        # ../reference_genomes/shadow/..., which generate_community.py also hardcodes)
        # resolve and pixi finds ../pixi.toml, regardless of the submitted job's CWD.
        # &> {log} captures stderr to a scratch file for debugging cluster jobs.
        'cd {workflow.basedir} && eval "$(pixi shell-hook -e art)" && '
        "mkdir -p {fastq_dir} {truth_dir} && {workflow.basedir}/generate_community.py --art art_illumina --threads {threads} --coverage-file {workflow.basedir}/coverage_definitions/coverage{params.coverage_number}.tsv --gtdb-bac-metadata {gtdb_bac_metadata} --gtdb-ar-metadata {gtdb_ar_metadata} --genome-list {genome_fasta_paths} --output-condensed {output.condensed} -1 {fastq_dir}/{wildcards.sample}.1.fq.gz -2 {fastq_dir}/{wildcards.sample}.2.fq.gz --output-genomewise-coverage {output.genomewise} &> {log}"

###############################################################################################
## low abundance removal (bench1-specific variant of the biobox/OPAL scoring)

def get_remove_low_abund_extra_args(tool):
    if tool in tools_with_filled_output_profiles:
        return ' --is-filled'
    else:
        return ''

rule remove_low_abundance_from_condensed:
    input:
        profile = output_prefix + "{tool}/{tool}/{sample}.profile",
    params:
        extra_args = lambda wildcards: get_remove_low_abund_extra_args(wildcards.tool)
    output:
        profile = output_prefix + "{tool}/low_abund/{sample}.profile",
    log:
        output_prefix + "{tool}/low_abund/{sample}.log",
    shell:
        # Threshold is 0.02% since total coverage in the truth is ~1704.973095 adn 0.35 divided by that is 0.02%
        'eval "$(pixi shell-hook -e singlem)" && '
        "PYTHONPATH=../singlem {workflow.basedir}/../bin/remove_low_abundance_from_condensed.py {params.extra_args} --input-condensed {input.profile} " \
        "--threshold 0.0002 > {output.profile} 2> {log}"

rule tool_condensed_to_biobox_low_abund:
    input:
        profile = output_prefix + "{tool}/low_abund/{sample}.profile",
        truth = truth_dir + "/{sample}.condensed.biobox",
    output:
        biobox = output_prefix + "{tool}/low_abund/{sample}.biobox",
    shell:
        # All profiles are unfilled since they came from remove_low_abundance_from_condensed.py
        'eval "$(pixi shell-hook -e singlem)" && '
        "{workflow.basedir}/../bin/condensed_profile_to_biobox.py --input-condensed-table {input.profile} " \
        "--output-biobox {output.biobox} --template-biobox {input.truth} "

rule opal_low_abund:
    input:
        biobox = output_prefix+"{tool}/low_abund/{sample}.biobox",
        truth = truth_dir + "/{sample}.condensed.biobox",
    params:
        output_opal_dir = output_prefix+"{tool}/opal_low_abund/{sample}.opal_output_directory",
    output:
        report=output_prefix+"{tool}/opal_low_abund/{sample}.opal_report",
        done=touch(output_prefix+"{tool}/opal_low_abund/{sample}.opal_report.done"),
    resources:
        runtime=60,  # opal is quick; request 1h (not the 48h default) so it gets backfill priority
    shell:
        'eval "$(pixi shell-hook -e opal)" && '
        "opal.py -g {input.truth} -o {params.output_opal_dir} {input.biobox} || echo 'expected opal non-zero existatus'; mv {params.output_opal_dir}/results.tsv {output.report} && rm -rf {params.output_opal_dir}"

# Shared rules (../rules): DB staging, common conversions/OPAL, and one file per
# profiler this benchmark runs. Read generation and low_abund are bench1-specific
# (above). singlem-regime3 rules are staged/defined for convenience even though
# `tools` (r207_tools) does not target them in `rule all`.
include: "../rules/staging.smk"
include: "../rules/common.smk"
