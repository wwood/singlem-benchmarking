import extern
import os

# Benchmark 7: the GTDB r232 metapackage as the backing database. This reuses
# benchmark 6's community verbatim -- 1000 distinct known GTDB r207 species, every
# one simulated below 1x coverage (median ~0.22x) -- but swaps every reference
# database from GTDB r207 to r232: the singlem metapackage (S6.5.0 / r232), the
# weebill two-stage sylph db (r232.100.syl2db) and the standalone sylph db
# (r232.100.syldb). Only the three tools with an r232 database are run: singlem,
# singlem-regime3 and sylph.
#
# The ground truth is written in r232 taxonomy (not r207), so tool output and
# truth share a taxonomy and legitimate r207->r232 reclassifications are not
# scored as errors. 119 of the 1000 genomes were dropped from GTDB between r207
# and r232; generate_community.py inner-joins on the r232 metadata, so the
# community actually simulated is the 881 surviving genomes -- reads and truth are
# generated together and stay consistent. See the README.

sys.path.append(os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(workflow.snakefile)), '..')))
from tool_reference_data import *

num_threads = config['benchmarking_threads']

# Per-benchmark setup: tools, output_dirs_dict, local db paths, datasets, and the
# r232 overrides of the source db paths / metadata / taxonomy. Imported AFTER
# tool_reference_data so its r232 values win.
sys.path.append(os.path.abspath(os.path.dirname(os.path.abspath(workflow.snakefile))))
from bench7_setup import *

fastq_dir = 'reads'
truth_dir = 'truths'

# Read generation inputs (consumed by ../rules/data_generation.smk). Reuses
# benchmark 6's generate_community.py driver (via 1_novel_strains) and genome list.
generate_community_script = os.path.join(workflow.basedir, '../1_novel_strains/generate_community.py')
genome_fasta_paths = os.path.join(workflow.basedir, 'genome_list.tsv')

# singlem-regime3 (weebill --two-stage + singlem pipe + condense --joint) paths,
# consumed by ../rules/singlem_regime3_run.smk.
singlem_regime3_git_base_directory = os.path.join(workflow.basedir, '../singlem_sylph_condense_regime')
regime3_weebill_scripts = os.path.join(
    singlem_regime3_git_base_directory, 'extras/singlem_sylph_weebill_benchmark/scripts')

print("Profiling {} over {} communities (r232-backed)".format(tools, len(datasets)))

# Constrain wildcards so the generic {tool}/{tool} biobox+opal rules cannot
# greedily match across path separators (a tool name contains a hyphen and
# shares the `singlem` prefix: singlem-regime3).
wildcard_constraints:
    tool="[A-Za-z0-9._-]+",
    sample="[A-Za-z0-9._]+",

# Databases this benchmark stages locally (opt-in for ../rules/staging.smk).
staged_tools = tools

# PBS/aqua jobs start in $HOME, not the workdir; cd in so workdir-relative paths
# (bin/, genome_list.tsv, ../*_taxonomy_r232.tsv, generate_community.py's
# ../*_metadata_r232.tsv) and the pixi manifest resolve on compute nodes.
shell.prefix("cd {} && ".format(workflow.basedir))

# Trivial table conversions run on the orchestrator host, not as 48h queue jobs.
localrules:
    truth_condensed_to_biobox,
    tool_condensed_to_biobox,
    sylph_report_to_condensed,

rule all:
    input:
        expand(output_prefix + "{tool}/opal/{sample}.opal_report", sample=datasets, tool=tools)

# Shared rules (../rules): read generation, DB staging, common conversions/OPAL,
# and one file per profiler this benchmark runs.
include: "../rules/data_generation.smk"
include: "../rules/staging.smk"
include: "../rules/common.smk"
include: "../rules/singlem_run.smk"
include: "../rules/sylph_run.smk"
include: "../rules/singlem_regime3_run.smk"
