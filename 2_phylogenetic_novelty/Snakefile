    output:
        profile = output_dirs_dict['map2b'] + "/map2b/{sample}.profile",
    shell:
        "{workflow.basedir}/../bin/map2b_to_condensed.py "
        "--abundance {input} "
        "--sample {wildcards.sample} "
        "> {output} "


